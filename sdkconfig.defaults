# Explicit transcription of the settings the precompiled Arduino 2.0.17 SDK
# supplied implicitly. The target itself comes from the PlatformIO board
# (`esp32s2`); these are the build and runtime settings this firmware depends
# on. Keep values in sync with partitions.csv and docs/BUILD_PARITY_BASELINE.md.

# Flash: 4 MB module, QIO at 80 MHz (board_build.flash_mode/f_flash equivalent)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# CPU: 80 MHz (replaces board_build.f_cpu in the Arduino environment)
CONFIG_ESP32S2_DEFAULT_CPU_FREQ_80=y
CONFIG_ESP32S2_DEFAULT_CPU_FREQ_MHZ=80

# Single core ESP32-S2
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_SYSTEM_SINGLE_CORE_MODE=y

# PSRAM policy: malloc-capable PSRAM with no internal reserve. The memory
# spec depends on this exact policy; see AGENTS.md and memory-management.
# IDF 4.4 names the target-specific switch ESP32S2_SPIRAM_SUPPORT; it selects
# SPIRAM. Boot init stays off so Arduino core's psramInit() owns initialization,
# matching the precompiled SDK.
CONFIG_ESP32S2_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=0

# Power management (adopt-esp-idf-build Phase 4). The precompiled SDK had
# CONFIG_PM_ENABLE off, so esp_pm_configure() could only return
# ESP_ERR_NOT_SUPPORTED. Enabling it here makes DFS available; setup() opts in
# explicitly. CONFIG_FREERTOS_USE_TICKLESS_IDLE is deliberately absent:
# automatic light sleep was tested both with USB CDC logging and with
# syslog-only logging, and in both builds the idle task eventually asserted in
# vTaskStepTick() and panicked (see docs/BUILD_PARITY_BASELINE.md §Phase 4.2).
CONFIG_PM_ENABLE=y

# Phase 4 instrumentation: the mode/lock counters are the only way to prove
# DFS actually leaves CPU_MAX while the USB CDC console is attached. The dump
# is emitted by Network::logDiagnostics(). Revisit this after the experiment is
# recorded; it adds lock bookkeeping to every acquire/release.
CONFIG_PM_PROFILING=y

# WiFi/lwIP memory shape: the precompiled Arduino 2.0.17 SDK used 8 static
# RX/TX buffers, not IDF's default 16, and kept the WiFi/RX code out of IRAM.
# Using the larger defaults costs ~25 KB of internal SRAM at boot, which shows
# up as the IDF build's lower heap headroom in docs/BUILD_PARITY_BASELINE.md.
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_RX_IRAM_OPT=n
CONFIG_ESP32_WIFI_IRAM_OPT=n

# Custom dual-app OTA partition layout (partitions.csv is project-owned)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# Rollback: a new image boots PENDING_VERIFY and reverts unless setup()
# confirms it (OTAUpdater::confirmRunningImage()).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Flash core dump: the boot summary in src/main.cpp depends on it.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y

# Arduino core: the precompiled SDK defaulted to the generic esp32s2 variant,
# which has the wrong pin map. Autostart is required for setup()/loop(); both
# the loop and event callbacks run on core 0.
CONFIG_ARDUINO_VARIANT="adafruit_qtpy_esp32s2"
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_RUN_CORE0=y
CONFIG_ARDUINO_RUNNING_CORE=0
CONFIG_ARDUINO_EVENT_RUN_CORE0=y
CONFIG_ARDUINO_EVENT_RUNNING_CORE=0
CONFIG_ARDUINO_LOOP_STACK_SIZE=8192
CONFIG_ENABLE_ARDUINO_DEPENDS=y

# C++ exceptions: the Arduino precompiled SDK enabled them, and the application
# uses try/catch (sensor construction, network task startup, guarded WiFi calls).
# IDF defaults to exceptions off and compiles with -fno-exceptions.
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=0
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# mbedTLS: Arduino's WiFiClientSecure source (compiled as part of the core
# component) only provides its SSL functions when PSK exchange modes are on.
# The precompiled SDK enabled them; without this the link fails on
# ssl_init()/start_ssl_client().
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# USB CDC console: USBCDC owns `Serial` only when the vendored Arduino TinyUSB
# component is enabled. The component lives in components/arduino_tinyusb.
CONFIG_TINYUSB_ENABLED=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=64
CONFIG_TINYUSB_CDC_TX_BUFSIZE=64
CONFIG_TINYUSB_DEBUG_LEVEL=0

# Watchdogs and panic behaviour: match the precompiled SDK's runtime defaults;
# setup() reconfigures the task watchdog to 30 s.
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# IDF console stays on UART0; the application's own log macros use USB CDC.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
